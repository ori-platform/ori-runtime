  "artifact": "custody_acknowledgement",
  "domain_ascii": "ori.evidence_custody_ack.v1",
  "domain_note": "Authenticated bytes are the ASCII domain, one NUL byte, then the canonical payload with signature or mac removed.",
  "canonicalisation": "json.dumps(obj, sort_keys=True, separators=(',',':'), ensure_ascii=False).encode('utf-8')",
  "authenticator_note": "Cases marked authenticator=valid must pass cryptographic verification so the semantic rule under test is actually reached. Cases marked invalid fail verification itself.",
  "warning": "Seeds below are published test values and must never sign anything real.",
  "shared_secret_hex": "7075626c69736865642d746573742d72756e74696d652d676174657761792d7365637265742d646f2d6e6f742d757365",
  "gateway_secret_hex": "7075626c69736865642d746573742d676174657761792d7365637265742d646f2d6e6f742d757365",
  "previous_gateway_secret_hex": "7075626c69736865642d746573742d637573746f64792d7365637265742d70726576696f75732d67656e65726174696f6e2d646f2d6e6f742d757365",
  "retired_gateway_secret_hex": "7075626c69736865642d746573742d637573746f64792d7365637265742d726574697265642d67656e65726174696f6e2d646f2d6e6f742d757365",
  "retired_secret_note": "Generator material only. It exists so the retired_key_id case can be produced with a real MAC. A conforming receiver holds a tombstone carrying the key_id and no secret, which is why that case is unverifiable by construction rather than merely unverified.",
  "secret_separation_note": "shared_secret_hex is the runtime-gateway envelope secret and gateway_secret_hex is the custody secret. They are distinct, and a custody MAC verifies only under the latter.",
  "gateway_secret_note": "The hex is the UTF-8 encoding of the shared-secret string, which is what the MAC key is. Decode to bytes and use directly; do not treat the hex as raw key material of some other origin.",
  "key_id_derivation": "key_id = \"hkdf-sha256:\" + lowercase_hex(HKDF-SHA256(ikm=secret UTF-8, salt=\"ori.evidence_custody_key_id.v1\" ASCII, info=\"gateway_custody\" ASCII, length=16))",
  "key_id_note": "Derived, never configured. The identifier names a secret generation and not a device: one gateway holding custody for several devices under one secret issues the same key_id for all of them.",
  "registry_state": {
    "active": {
      "key_id": "hkdf-sha256:d6aff3c0837ca1a07a5124e30d9612ac",
      "secret": "gateway_secret_hex"
    },
    "verify_only": {
      "key_id": "hkdf-sha256:a9a0a00f72f5b7b8499577306838f790",
