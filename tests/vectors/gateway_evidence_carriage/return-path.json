    {"name": "an unpaired high surrogate escape", "text": "{\"artifact_type\":\"delivery_receipt\",\"v\":1,\"probe\":\"\\ud800\"}", "canonical": false},
    {"name": "an unpaired low surrogate escape", "text": "{\"artifact_type\":\"delivery_receipt\",\"v\":1,\"probe\":\"x\\udc00\"}", "canonical": false},
