    {
      "name": "required_unless_unsatisfied",
      "protocol": "usb_serial",
      "schema": {
        "auto_detect_device_path": {
          "type": "boolean",
          "default": false
        },
        "device_path": {
          "type": "string",
          "required_unless": {
