{
  "contract": "safety-profile/v1",
  "version": 1,
  "comment": "Activation cases. Every zone here has already passed all twelve stages of the commissioned binding contract; the fields carried are the ones activation reads and no others. installed_skills is present so that a consumer can prove it is not an input: it never changes an expectation.",
  "fixtures_comment": "Ratified fixture profiles that exist only in this file. Every shipped profile is a candidate and cannot be activated, so the cases run against these; they carry the shipped numbers so a consumer's evaluator is exercised at the values it will meet.",
  "fixtures": [
    {
      "v": 1,
      "id": "fixture.overcurrent.v1",
      "status": "ratified",
      "observes": {
        "quantity": "current",
        "unit": "ampere"
      },
      "condition": {
        "kind": "upper_capacity_multiplier",
        "capacity_parameter": "rated_capacity_amps",
        "multiplier": 2.0
      },
      "outcome": "open_protected_circuit"
    },
    {
      "v": 1,
      "id": "fixture.overvoltage.v1",
      "status": "ratified",
      "observes": {
        "quantity": "voltage",
        "unit": "volt"
      },
      "condition": {
        "kind": "upper_bound",
        "threshold": 260.0
      },
      "outcome": "open_protected_circuit"
    },
    {
      "v": 1,
      "id": "fixture.gas.v1",
      "status": "ratified",
      "observes": {
        "quantity": "gas_concentration",
        "unit": "ppm"
      },
      "condition": {
        "kind": "upper_bound",
        "threshold": 400.0
      },
      "outcome": "open_protected_circuit"
    }
  ],
  "activation_order": [
    "pending_ratification",
    "unit_mismatch",
    "direction_unsupported",
    "parameter_mismatch",
    "trip_point_unobservable",
    "undemonstrated_binding"
  ],
  "cases": [
    {
      "name": "two_zone_site_activates_overcurrent_on_both",
      "note": "The binding corpus's reference site. Two current zones with different capacities activate the same profile at different trip points.",
      "posture": "production",
      "profile_set": "fixtures",
      "installed_skills": [],
      "zones": [
        {
          "zone_id": "main-distribution",
          "sensor": {
            "sensor_id": "load-current-main",
            "quantity": "current",
            "unit": "ampere",
            "range_min": 0.0,
            "range_max": 30.0,
            "direction": "positive_is_load_draw"
          },
          "rated_capacity": {
            "parameter": "rated_capacity_amps",
            "value": 10.0
          },
          "proof_method": "actuate_and_observe"
        },
        {
          "zone_id": "borehole-pump",
          "sensor": {
            "sensor_id": "load-current-pump",
            "quantity": "current",
            "unit": "ampere",
            "range_min": 0.0,
            "range_max": 100.0,
            "direction": "positive_is_load_draw"
          },
          "rated_capacity": {
            "parameter": "rated_capacity_amps",
            "value": 4.0
          },
          "proof_method": "actuate_and_observe"
        }
      ],
      "expect": {
        "activated": [
          {
            "zone_id": "main-distribution",
            "profile": "fixture.overcurrent.v1",
            "trip_point": 20.0
          },
          {
            "zone_id": "borehole-pump",
            "profile": "fixture.overcurrent.v1",
            "trip_point": 8.0
          }
        ],
        "refused": [],
        "pending_ratification": [],
        "uncovered_zones": [],
        "startup": "start"
      }
    },
