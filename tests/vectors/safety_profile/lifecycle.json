{
  "contract": "safety-profile/v1",
  "version": 1,
  "comment": "Lifecycle cases: a sequence of events applied to one zone with one active profile, and the trip state after each. startup carries the durable state the consumer finds on disk. Every event names the state expected afterwards; an event that executes an outcome names it, and an event that is refused names the refusal. Readings here are credible unless a case says otherwise.",
  "fixtures_comment": "Ratified fixture profiles that exist only in this file. Every shipped profile is a candidate and cannot be activated, so the cases run against these; they carry the shipped numbers so a consumer's evaluator is exercised at the values it will meet.",
  "fixtures": [
    {
      "v": 1,
      "id": "fixture.overcurrent.v1",
      "status": "ratified",
      "observes": {
        "quantity": "current",
        "unit": "ampere"
      },
      "condition": {
        "kind": "upper_capacity_multiplier",
        "capacity_parameter": "rated_capacity_amps",
        "multiplier": 2.0
      },
      "outcome": "open_protected_circuit"
    },
    {
      "v": 1,
      "id": "fixture.overvoltage.v1",
      "status": "ratified",
      "observes": {
        "quantity": "voltage",
        "unit": "volt"
      },
      "condition": {
        "kind": "upper_bound",
        "threshold": 260.0
      },
      "outcome": "open_protected_circuit"
    },
    {
      "v": 1,
      "id": "fixture.gas.v1",
      "status": "ratified",
      "observes": {
        "quantity": "gas_concentration",
        "unit": "ppm"
      },
      "condition": {
        "kind": "upper_bound",
        "threshold": 400.0
      },
      "outcome": "open_protected_circuit"
    }
  ],
  "states": [
    "inactive",
    "armed",
    "tripped"
  ],
  "arm_refusals": [
    "tripped",
    "safety_path_unconfirmed",
    "no_credible_reading"
  ],
  "reset_refusals": [
    "not_tripped",
    "no_credible_reading",
    "condition_active"
  ],
  "external_refusal": "no_authority",
  "cases": [
    {
      "name": "arm_trip_latch_restart_reset",
      "note": "The reference sequence: a clean start arms, a hazard trips and latches, a restart does not close the circuit, a reset is refused while the hazard persists and succeeds once it clears.",
      "profile": "fixture.overcurrent.v1",
      "zone": {
        "rated_capacity": {
          "parameter": "rated_capacity_amps",
          "value": 10.0
        },
        "sensor": {
          "unit": "ampere",
          "range_min": 0.0,
          "range_max": 30.0
        }
      },
      "trip_point": 20.0,
      "events": [
        {
          "event": "startup",
          "durable_state": "none",
          "expect_state": "inactive"
        },
        {
          "event": "safety_path_confirmed",
          "expect_state": "inactive"
        },
        {
          "event": "arm_attempt",
          "expect_state": "inactive",
          "expect_refusal": "no_credible_reading"
        },
        {
          "event": "reading",
          "value": 5.0,
          "expect_state": "inactive"
        },
        {
          "event": "arm_attempt",
          "expect_state": "armed",
          "expect_outcome": "close_protected_circuit"
        },
        {
          "event": "reading",
          "value": 25.0,
          "expect_state": "tripped",
          "expect_outcome": "open_protected_circuit"
        },
        {
          "event": "reading",
          "value": 3.0,
          "expect_state": "tripped"
        },
        {
          "event": "restart",
          "durable_state": "tripped",
          "expect_state": "tripped"
        },
        {
          "event": "safety_path_confirmed",
          "expect_state": "tripped"
        },
        {
          "event": "arm_attempt",
          "expect_state": "tripped",
          "expect_refusal": "tripped"
        },
        {
          "event": "reading",
          "value": 25.0,
          "expect_state": "tripped"
        },
        {
          "event": "reset_attempt",
          "expect_state": "tripped",
          "expect_refusal": "condition_active"
        },
        {
          "event": "reading",
          "value": 3.0,
          "expect_state": "tripped"
        },
        {
          "event": "reset_attempt",
          "expect_state": "armed",
          "expect_outcome": "close_protected_circuit"
        }
      ]
    },
    {
      "name": "arm_requires_safety_path",
