        {
          "event": "reading",
          "value": 5.0,
          "expect_state": "inactive"
        },
        {
          "event": "arm_attempt",
          "expect_state": "inactive",
          "expect_refusal": "safety_path_unconfirmed"
        },
        {
          "event": "safety_path_confirmed",
          "expect_state": "inactive"
