{
  "contract": "safety-profile/v1",
  "version": 1,
  "comment": "Profile-load cases: a complete profile set in, loaded or malformed_profile out. A consumer applies the closed grammar to the set it ships and refuses to start in every posture on a refusal. Each malformed case carries exactly one defect, and must_name lists identifiers the refusal must contain.",
  "cases": [
    {
      "name": "v1_set_loads",
      "note": "The shipped v1 set.",
      "profiles": [
        {
          "v": 1,
          "id": "electrical.overcurrent.v1",
          "status": "candidate",
          "observes": {
            "quantity": "current",
            "unit": "ampere"
          },
          "condition": {
            "kind": "upper_capacity_multiplier",
            "capacity_parameter": "rated_capacity_amps",
            "multiplier": 2.0
          },
          "outcome": "open_protected_circuit"
        },
        {
          "v": 1,
          "id": "electrical.overvoltage.v1",
          "status": "candidate",
          "observes": {
            "quantity": "voltage",
            "unit": "volt"
          },
          "condition": {
            "kind": "upper_bound",
            "threshold": 260.0
          },
          "outcome": "open_protected_circuit"
        },
        {
          "v": 1,
          "id": "gas.concentration.v1",
          "status": "candidate",
          "observes": {
            "quantity": "gas_concentration",
            "unit": "ppm"
          },
          "condition": {
            "kind": "upper_bound",
            "threshold": 400.0
          },
          "outcome": "open_protected_circuit"
        }
      ],
      "expect": "loaded"
    },
    {
      "name": "undeclared_profile_key_refused",
      "note": "A key the profile grammar does not admit. Ignoring it would let a stale or misspelt declaration appear to have taken effect.",
