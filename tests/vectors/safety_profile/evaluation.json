{
  "contract": "safety-profile/v1",
  "version": 1,
  "comment": "Evaluation cases: one active profile, the zone facts it consumes, one reading, one verdict. A reading value is a JSON number, a JSON string (non_numeric), a JSON boolean (boolean), or an object {\"non_finite\": \"nan\" | \"+inf\" | \"-inf\"} that the consumer converts to the IEEE value before evaluating, because JSON cannot carry those values directly.",
  "fixtures_comment": "Ratified fixture profiles that exist only in this file. Every shipped profile is a candidate and cannot be activated, so the cases run against these; they carry the shipped numbers so a consumer's evaluator is exercised at the values it will meet.",
  "fixtures": [
    {
      "v": 1,
      "id": "fixture.overcurrent.v1",
      "status": "ratified",
      "observes": {
        "quantity": "current",
        "unit": "ampere"
      },
      "condition": {
        "kind": "upper_capacity_multiplier",
        "capacity_parameter": "rated_capacity_amps",
        "multiplier": 2.0
      },
      "outcome": "open_protected_circuit"
    },
    {
      "v": 1,
      "id": "fixture.overvoltage.v1",
      "status": "ratified",
      "observes": {
        "quantity": "voltage",
        "unit": "volt"
      },
      "condition": {
        "kind": "upper_bound",
        "threshold": 260.0
      },
      "outcome": "open_protected_circuit"
    },
    {
      "v": 1,
      "id": "fixture.gas.v1",
      "status": "ratified",
      "observes": {
        "quantity": "gas_concentration",
        "unit": "ppm"
      },
      "condition": {
        "kind": "upper_bound",
        "threshold": 400.0
      },
      "outcome": "open_protected_circuit"
    }
  ],
  "rejection_reason_order": [
    "boolean",
    "non_numeric",
    "non_finite",
    "unit_mismatch",
    "zero_quality",
    "out_of_range"
  ],
  "cases": [
    {
      "name": "overcurrent_above_trip_point_trips",
      "note": "25 A against a 20 A trip point.",
      "profile": "fixture.overcurrent.v1",
      "zone": {
        "rated_capacity": {
          "parameter": "rated_capacity_amps",
          "value": 10.0
        },
        "sensor": {
          "unit": "ampere",
          "range_min": 0.0,
          "range_max": 30.0
        }
      },
      "reading": {
        "value": 25.0,
        "unit": "ampere",
        "quality": 1.0
      },
      "trip_point": 20.0,
      "expect": {
        "verdict": "trip"
      }
    },
    {
      "name": "overcurrent_at_trip_point_does_not_trip",
      "note": "The comparison is strict: exactly the trip point is not above it.",
      "profile": "fixture.overcurrent.v1",
      "zone": {
        "rated_capacity": {
          "parameter": "rated_capacity_amps",
          "value": 10.0
        },
        "sensor": {
          "unit": "ampere",
