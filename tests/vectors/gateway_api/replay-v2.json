{
  "contract": "ori-specs/gateway-api/v2.md",
  "section": "Envelope Freshness and Replay",
  "comment": "Each case is a receiver context and a run of events in order. Every envelope's signature and topic-device check hold. A receiver replaying a case reproduces each event's reason (receive, authenticate and commit only; null when accepted), its floor and its held keys afterwards. Times are milliseconds on the receiver's clock; a commit records with the receipt time of its authenticate.",
  "reasons": [
    "stale_timestamp",
    "future_timestamp",
    "before_replay_floor",
    "replay_detected"
  ],
  "cases": [
    {
      "name": "floor_equality",
      "note": "an envelope signed exactly at the floor is accepted; one millisecond below it is refused",
      "context": {
        "skew_ms": 300,
        "replay_ttl_ms": null,
        "stores": true,
        "stored_floor_ms": 10000,
        "start_clock_ms": 0,
        "held": []
      },
      "events": [
        {
          "event": "receive",
          "key": "a",
          "signed_at_ms": 10000,
          "t": 10100,
          "expected": {
            "reason": null,
            "floor_ms": 10000,
            "held": [
              "a"
            ]
          }
        },
        {
          "event": "receive",
          "key": "b",
          "signed_at_ms": 9999,
          "t": 10100,
          "expected": {
            "reason": "before_replay_floor",
            "floor_ms": 10000,
            "held": [
              "a"
            ]
          }
        }
      ]
    },
    {
      "name": "skew_bounds",
