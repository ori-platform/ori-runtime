      },
      "transport": {
        "topic": "ori/fw/ori-fw-7c9f2b3a/runtime",
        "retain": true
      },
      "message_hex": "",
      "note": "byte-identical to a message the device must accept when delivered live. A device reconnecting after the runtime died would otherwise suppress its own backstop for a full expiry window on the strength of a stored message"
    }
