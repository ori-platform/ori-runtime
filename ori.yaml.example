# ori.yaml.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to ori.yaml and edit for your device.
# ori.yaml is gitignored — never commit it.
#
# ACTION TIER REFERENCE:
#   Tier A  INFORMATIONAL   — Always autonomous. Alerts, logs, reports.
#   Tier B  SOFT PHYSICAL   — Approval or post-action policy required.
#   Tier C  HARD PHYSICAL   — Approval workflow required. Relay/contactor shutdowns.
#   Tier D  SAFETY-CRITICAL — Always autonomous. Cannot be overridden.
# ─────────────────────────────────────────────────────────────────────────────

device:
  id: energy-monitor-ikeja-01        # unique, no spaces, no special chars
  name: Ikeja Office Energy Monitor
  location: Lagos, Nigeria
  site_type: office                 # business context for Tier C logs: office | pharmacy | factory | warehouse
  country_code: NG                  # ISO 3166-1 alpha-2 (e.g. NG, KE, US)
  deployment_type: pi                # pi | phone | edge_node | server
  deployment_profile: development    # development | staging | production
                                     # staging/production enforce hardened posture
                                     # and refuse configured GPIO, CoAP, or local-SLM
                                     # capabilities when their host backend is absent
  rated_capacity_amps: 10.0          # used for Tier D threshold calculations
                                     # set this to the actual rated amperage
                                     # of your main circuit
  timezone: Africa/Lagos             # IANA timezone for operator-facing timestamps
                                     # if omitted/invalid, runtime falls back to host timezone, then UTC
                                     # e.g. Africa/Lagos, Europe/London, America/New_York

sensors:
  # ─── Current clamp on ADS1115 ADC via I2C ───────────────────────────────
  # SCT-013-030 clips around the main load cable in the distribution board
  # Non-invasive — no wiring changes required
  - id: load-current
    type: ads1115_current
    protocol: i2c
    address: 0x48                    # ADS1115 default I2C address
    channel: 0                       # ADS1115 channel A0
    poll_interval_ms: 1000
    calibration:
      # Both are required and have no defaults: they are facts about this
      # installation, and a guessed value produces a plausible number rather
      # than a measurement.
      #
      # The clamp's output in volts RMS per ampere RMS. Read it off the part:
      # a clamp marked "30A : 1V" is 1/30 = 0.0333; one marked "100A : 50mA"
      # is a current-output type and needs a burden resistor, after which the
      # figure is the burden's volts per ampere.
      sensitivity_v_per_amp: 0.0333
      # The supply frequency the sampling window is aligned to.
      mains_frequency_hz: 50
      # Optional deterministic gateway-escalation guardrails.
      # When gateway reasoning transport is available, readings outside these
      # bounds escalate before local SLM inference.
      # min_value: 0.0
      # max_value: 30.0

  # ─── Grid voltage sensor on ADS1115 channel 1 ───────────────────────────
  # One ADS1115 serves one sensor per runtime. The chip has a single input
  # multiplexer, and a second sensor on the same chip moves it under the first
  # — the runtime refuses that at connect. A second channel means a second
  # chip: ADDR to VDD selects 0x49.
  - id: grid-voltage
    type: ads1115_voltage
    protocol: i2c
    address: 0x49
    channel: 1
    poll_interval_ms: 2000

  # ─── Serial Modbus meter (optional) ──────────────────────────────────────
  # Example for PZEM/SDM-style RS485 meters over USB serial
  - id: grid-active-power
    type: active_power
    protocol: serial
    port: /dev/ttyUSB0
    baud_rate: 9600
    poll_interval_ms: 5000

  # ─── Growatt inverter via SolarmanV5 (optional) ─────────────────────────
  # Uncomment for installations with a validated Growatt WiFi/LAN dongle.
  # SolarmanV5 is the transport; Deye/Sunsynk/Felicity register maps need
  # separate model qualification before using them in production.
  # - id: inverter-solar-power
  #   type: growatt_pv_power
  #   protocol: growatt
  #   host: "192.168.1.XXX"
  #   serial: "XXXXXXXXXX"
  #   port: 8899
  #   poll_interval_ms: 5000

  # ─── Data-driven SolarmanV5 inverter profile (Pi / Edge Node / phone) ─────
  # Preferred for new SolarmanV5 LAN integrations because the register map
  # lives in a versioned inverter profile instead of adapter code.
  # Bundled profiles such as growatt_spf and deye_hybrid are
  # community_derived until field evidence promotes an exact model/firmware.
  # - id: inverter-grid-power
  #   type: deye_grid_power
  #   protocol: solarman_modbus
  #   profile: deye_hybrid
  #   host: "192.168.1.XXX"
  #   serial: "XXXXXXXXXX"            # inverter logger/dongle serial
  #   port: 8899
  #   poll_interval_ms: 5000

  # ─── Victron inverter via VenusOS MQTT (optional) ──────────────────────────
  # - id: victron-battery
  #   type: victron_battery_soc
  #   protocol: victron
  #   broker_host: "192.168.1.50"
  #   portal_id: "YOUR_PORTAL_ID"
  #   port: 1883
  #   # Optional broker auth/TLS (works with Mosquitto and other MQTT brokers)
  #   mqtt:
  #     username: "mqtt-user"
  #     password: "${MQTT_PASSWORD}"
  #     client_id: "ori-victron-01"
  #     keepalive: 90
  #     tls:
  #       enabled: false
  #       insecure: false
  #       # ca_certfile: "/etc/ssl/certs/ca-certificates.crt"
  #       # certfile: "/path/to/client.crt"
  #       # keyfile: "/path/to/client.key"
  #   poll_interval_ms: 5000

  # ─── OPC-UA industrial PLC sensor (optional) ───────────────────────────────
  # - id: plc-temperature
  #   type: temperature
  #   protocol: opcua
  #   url: "opc.tcp://192.168.1.100:4840"
  #   node_id: "ns=2;i=1002"
  #   poll_interval_ms: 1000

  # ─── PC/Mac system health (PC-Ori) ──────────────────────────────────────
  # Uncomment to monitor the host machine — no hardware required
  # - id: system-cpu
  #   type: cpu_percent
  #   protocol: psutil
  #   poll_interval_ms: 5000
  #
  # - id: system-memory
  #   type: memory_percent
  #   protocol: psutil
  #   poll_interval_ms: 10000
  #
  # - id: system-temp
  #   type: cpu_temp
  #   protocol: psutil
  #   poll_interval_ms: 10000

  # ─── Phone Gateway USB meter (Termux path) ───────────────────────────────
  # - id: mains-power
  #   type: usb_power
  #   protocol: usb_serial
  #   device_path: /dev/ttyUSB0
  #   baud_rate: 9600
  #   poll_interval_ms: 2000

  # ─── Drive SMART health (PC-Ori extension) ────────────────────────────────
  # - id: drive-temp
  #   type: drive_temp_celsius
  #   protocol: smart
  #   device: /dev/sda
  #   poll_interval_ms: 60000

  # ─── Virtual sensor: weather API (optional) ───────────────────────────────
  # - id: outdoor-temperature
  #   type: temperature
  #   protocol: http
  #   url: "http://api.openweathermap.org/data/2.5/weather?q=Lagos&appid=YOUR_KEY"
  #   json_path: "main.temp"
  #   unit: kelvin
  #   poll_interval_ms: 300000

  # ─── CoAP telemetry sensor (optional) ──────────────────────────────────────
  # Requires the host to be listed under actions.coap.allowed_hosts.
  # - id: room-temp-coap
  #   type: temperature
  #   protocol: coap
  #   uri: "coap://192.168.1.70/telemetry/temp"
  #   method: GET
  #   json_path: "metrics.temp_c"
  #   unit: celsius
  #   poll_interval_ms: 2000

  # ─── Zigbee smart-home sensor via MQTT bridge (optional) ──────────────────
  # Requires zigbee2mqtt (or equivalent) publishing JSON payloads.
  # - id: living-room-temp
  #   type: temperature
  #   protocol: zigbee
  #   broker_host: "192.168.1.55"
  #   topic: "zigbee2mqtt/living-room"
  #   port: 1883
  #   # value_path defaults from sensor type mapping; override if needed:
  #   # value_path: "temperature"
  #   # quality_path: "quality"
  #   poll_interval_ms: 2000

  # ─── LoRaWAN uplink sensor via MQTT broker (optional) ─────────────────────
  # Works with TTN/ChirpStack MQTT uplink events using configurable JSON paths.
  # - id: field-temperature
  #   type: lorawan_temperature
  #   protocol: lorawan
  #   broker_host: "192.168.1.88"
  #   topic: "v3/app@ttn/devices/device-01/up"
  #   port: 1883
  #   # value_path defaults from sensor type mapping; override for your payload:
  #   # value_path: "uplink_message.decoded_payload.temperature"
  #   poll_interval_ms: 5000

  # ─── Generic MQTT telemetry sensor (optional) ─────────────────────────────
  # Use this when a device publishes JSON measurements to a broker.
  # - id: chiller-supply-temp
  #   type: temperature
  #   protocol: mqtt
  #   broker_host: "192.168.1.20"
  #   topic: "plant/chiller-1/supply"
  #   value_path: "reading.value"
  #   quality_path: "reading.quality"
  #   unit: celsius
  #   poll_interval_ms: 2000

  # ─── External perception stream via MQTT (optional) ───────────────────────
  # Payload contract expected on topic:
  # {
  #   "schema": "ori.perception.v1",
  #   "sensor_type": "ppe_hardhat_violation_score",
  #   "value": 0.84,
  #   "confidence": 0.91,
  #   "timestamp_ms": 1710000000123,
  #   "metadata": {
  #     "zone_id": "line-3",
  #     "camera_id": "cam-04",
  #     "subject_id": "worker-17"
  #   }
  # }
  # - id: ppe-hardhat-cam-04
  #   type: ppe_hardhat_violation_score
  #   protocol: mqtt_perception
  #   broker_host: "192.168.1.20"
  #   topic: "ori/perception/site-b/cam-04"
  #   port: 1883
  #   poll_interval_ms: 1000
  #
  # - id: ppe-vest-cam-04
  #   type: ppe_vest_violation_score
  #   protocol: mqtt_perception
  #   broker_host: "192.168.1.20"
  #   topic: "ori/perception/site-b/cam-04"
  #   port: 1883
  #   poll_interval_ms: 1000


skills:
  - name: energy-anomaly-detector
    version: '0.2.1'
    config:
      energy_cost_naira: 225         # N/kWh — update with current rate
      owner_name: "Ikeja Office"
      requires_approval_for_soft_actions: false
      approval_timeout_seconds: 300
      safe_default_action: log_to_dashboard
      # secondary_contact_number: "${SECONDARY_WHATSAPP}"


reasoning:
  default_tier: local                # rule | local (gateway selected by escalation policy)
  local_model: qwen2.5-0.5b-instruct-q4_k_m  # basename or full .gguf filename/path
  model_path: /home/pi/models/       # directory containing local GGUF models
  escalation_threshold: 0.70        # complexity threshold; local SLM confidence is non-authoritative
  capability_posture:
    enabled: true
    probe_interval_seconds: 30      # must be <=30; posture refresh cadence
    gateway_heartbeat_ttl_seconds: 30
    internet_probe_host: one.one.one.one
    internet_probe_port: 53
    internet_probe_timeout_ms: 1000
  energy_aware_reasoning:
    enabled: true
    throttle_threshold_percent: 20
    critical_threshold_percent: 10
    battery_sensor_id: ""            # set to a real battery sensor id (for example victron-battery or inverter-battery-soc)
    alert_on_throttle: true
  causal_memory:
    enabled: false
    min_confidence_to_store: 0.0
    rejection_expiry_days: 30      # 0 = never expire
  context_enricher:
    enabled: false                 # disabled by default; opt-in per deployment
    staleness_window_ms: 60000     # exclude readings older than 60 s at prompt-build time
    max_entries: 5                 # hard cap on snapshot size (1–20)
    include_sources: []            # empty = all adapter sources; e.g. ["i2c", "mqtt"]


gateway:
  enabled: false                     # starts MQTT gateway integration over the LAN broker
  broker_url: mqtt://192.168.1.10:1883
  broker_posture:
    deployment_check: warning        # warning | required; production non-loopback requires required
    anonymous_access: unknown        # unknown | disabled; production non-loopback requires disabled
    require_credentials: false       # true => broker_url must include username and password
    acl_policy: unknown              # unknown | per_device_required; production non-loopback requires per_device_required
  tls:
    enabled: false                   # use mqtts:// or set true when broker TLS is required
    ca_certfile: ""                  # e.g. /etc/ori/certs/site-ca.crt
    certfile: ""                     # optional client certificate
    keyfile: ""                      # optional client private key
    keyfile_password_env: ""         # env var name only, if keyfile is encrypted
  auth:
    enabled: false                   # required in staging/production for every broker, loopback included; development warns
    shared_secret_env: GATEWAY_SHARED_SECRET # env var name only; never put the secret in ori.yaml
    previous_shared_secret_env: ""   # optional verify-only previous secret env during rotation
    max_clock_skew_ms: 300000
    replay_ttl_ms: 300000
    persistent_replay_cache: true    # persist seen envelope keys to the state DB so restarts cannot reopen the replay window
  custody:
    # A SEPARATE secret from auth.shared_secret_env above, for a different
    # purpose: this one authenticates the gateway's claim that it is carrying
    # evidence. Reusing the envelope secret would let anything holding it for
    # one purpose mint artifacts for the other.
    #
    # Generate it from a CSPRNG with at least 256 bits of entropy -- for
    # example `openssl rand -base64 32` -- and provision it with no surrounding
    # whitespace, since the key is the secret's exact UTF-8 bytes and a stray
    # newline derives an identifier the gateway does not hold. A passphrase is
    # not acceptable: the custody MAC is what stands between this runtime's
    # queue and anything on the site network that can reach the broker, and
    # nothing at startup can measure entropy, so this one is yours to keep.
    secret_env: ""                   # env var name only; never put the secret in ori.yaml
    previous_secret_env: ""          # optional verify-only previous generation during rotation
    # A retired generation is named, never re-derived: retiring it destroys the
    # secret, so this identifier is the only record it existed. Keeping it is
    # what lets the runtime say "retired" instead of "unknown" when a courier
    # presents evidence acknowledged under it.
    retired_key_ids: []              # e.g. ["hkdf-sha256:<32 lowercase hex>"]
  encryption:
    enabled: false                   # required in staging/production for every broker; requires gateway.auth.enabled
  node_heartbeat:
    enabled: true                    # publish runtime liveness to ori/{device_id}/runtime/heartbeat
    interval_seconds: 30
  firmware_telemetry:
    enabled: false                   # subscribe to signed evidence Layer 1 firmware telemetry
    topic: ori/fw/+/telemetry        # signed telemetry and signed fault events
    qos: 1                           # firmware publishes QoS 1; receiver deduplicates by boot_id/seq
  firmware_commands:
    # Signed egress to firmware devices: provisioning approvals, physical
    # commands, and the runtime liveness signal that tells a device an
    # authority is alive and watching it.
    #
    # Enabling this makes THIS runtime the authority for those devices.
    # Broker connectivity proves a session, not that a runtime exists; a
    # live broker with a dead runtime leaves a device connected,
    # unsupervised, and with its Local Interlock backstop suppressed.
    enabled: false                   # off by default: egress grants physical command authority
    # Both env vars carry canonical base64 for an exactly 32-byte Ed25519
    # seed, not raw bytes and not a PEM. A value that decodes to any other
    # length, or whose base64 is non-canonical, is refused at startup.
    runtime_command_key_env: ORI_FW_RUNTIME_COMMAND_KEY
    # The same provisioning-authority secret used by firmware_mqtt_provisioning
    # below. One authority, one secret: a second env var holding a second copy
    # is a second thing to rotate and a second thing to get wrong.
    provisioner_key_env: ORI_FW_PROVISIONER_KEY
    qos: 1                           # QoS 1; freshness counters already make redelivery harmless
    publish_timeout_s: 10.0          # per-publish timeout before the attempt is abandoned
    # Runtime liveness has NO separate enable flag, deliberately: command
    # authority and its supervision assertion are one operational posture.
    # Once firmware switches to signed liveness, a device whose runtime
    # assertion expires may become orphaned when no gateway is reachable
    # (orphaned = !runtime_reachable && !gateway_reachable). Firmware today
    # still derives runtime_reachable from broker connectivity, so this
    # setting does not yet affect orphan state.
    liveness_interval_s: 15.0        # 1.0 .. 20.0; must be <= expiry window (60s) / 3
    # Firmware authority becomes effective only when this runtime and the
    # evidence store agree on the same anchor_epoch_id. Approval records that
    # obligation durably but cannot itself reach the store, so a confirmation
    # arriving later needs something to re-examine it — without this a
    # normally-approved device with no firmware traffic waits for a restart.
    # Cycles that resolve nothing double the delay, up to a fixed 15-minute
    # ceiling; a restored transport reconciles immediately and clears the
    # backoff. The interval is bounded by that same ceiling, since a base
    # delay above it would leave nowhere to back off to.
    confirmation_retry_interval_s: 60.0  # 1.0 .. 900.0 (the backoff ceiling)
  reasoning:
    enabled: true                    # Tier 3 request/response on ori/{device_id}/reasoning/*
    timeout_ms: 10000                # per-phase timeout: connect/subscribe and response wait

telemetry_export:
  # Optional direct provisioned telemetry export for phone/lightweight deployments.
  # Separate from gateway MQTT exports. Mirrors real sensor.reading events only;
  # never affects Tier B/C/D action authority.
  enabled: false
  endpoint: "https://provisioning.example.invalid/runtime/telemetry"
  api_key_env: ORI_ENERGY_DEVICE_API_KEY
  flush_interval_s: 30
  batch_size: 50
  timeout_ms: 3000
  max_queue_size: 1000

device_policy:
  enabled: false
  url: "https://api.ori.cloud/v1/device-policy" # ori-cloud endpoint for signed DevicePolicy
  auth_token: "${ORI_DEVICE_POLICY_TOKEN}"      # device auth bearer token
  public_key_b64: "${ORI_CLOUD_PUBKEY_B64}"     # ori-cloud Ed25519 public key (base64)
  request_timeout_ms: 3000
  max_clock_skew_s: 300
  refresh_enabled: false                         # background refresh loop
  refresh_interval_s: 21600                      # 6h; minimum allowed is 60s

health_socket:
  enabled: true
  path: /run/ori/health.sock                     # local read-only runtime health RPC
  mode: 0o660                                    # unix socket permission bits

firmware_mqtt_provisioning:
  enabled: false
  socket_path: /run/ori/firmware-mqtt-provisioning.sock
  socket_mode: 0o600                             # never grant world access
  allowed_uids: []                               # empty means the runtime effective uid only
  provisioner_key_env: ORI_FW_PROVISIONER_KEY
  client_ca_certfile: /etc/ori/mqtt-client-ca.crt
  client_ca_keyfile: /etc/ori/mqtt-client-ca.key # regular, root/runtime-owned, mode 0o600
  client_ca_key_password_env: ""                 # optional; the password itself never enters YAML
  broker_ca_certfile: /etc/ori/mqtt-broker-ca.crt
  broker_uri: mqtts://broker.example.com:8883
  time_server: time.example.com
  certificate_validity_days: 90

# Community hook execution is disabled in this release. A skill that does not
# ship with the runtime and carries hooks.py is refused entirely; there is no
# in-process fallback, and these settings no longer decide whether untrusted
# hook code runs. They are retained for the isolated-worker contract being
# specified in ori-specs. See DECISIONS.md (2026-08-15).
os_sandbox:
  enabled: true
  require_for_community: false                   # no longer a hook-execution control
  exec_timeout_ms: 2000
  max_output_bytes: 65536

database:
  path: ori_state.db                             # production should place this under an encrypted mount

security:
  # Set true, or set device.deployment_profile to staging/production, to fail
  # startup on unsafe network/security posture. A staging/production profile
  # cannot be weakened by setting this false.
  enforce_production_posture: false
  config_signature:
    # Generated configs from APK provisioning should set this true.
    # The verification public key is supplied outside this YAML through the env
    # var below, so a tampered config cannot swap its own trust anchor.
    require_signed: false
    trust_anchor_env: ORI_CONFIG_TRUST_ANCHOR_PUBLIC_KEY_B64
  skills:
    # Skills that do not ship with the runtime always require a verified
    # ed25519 signature — this setting does not exempt them. For packaged
    # first-party skills it only requires the signature field to carry a
    # recognised declaration prefix ('bundled' or 'ed25519:'); the value is not
    # decoded or verified, and their authenticity comes from the signed release
    # artifact. See DECISIONS.md (2026-08-15).
    require_signed: false
  remote_commands:
    enabled: false                               # state-changing SMS/WhatsApp/cloud commands require HMAC
    hmac_secret_env: ORI_REMOTE_COMMAND_HMAC_SECRET
    previous_hmac_secret_env: ""                 # optional verify-only previous secret env during rotation
    max_skew_seconds: 300
    # Fail-closed sender binding. When remote_commands.enabled=true, commands
    # are rejected unless they arrive from one of these channel-specific senders,
    # or allow_unlisted_senders is explicitly set true for test deployments.
    allow_unlisted_senders: false
    allowed_senders:
      sms:
        - "${OWNER_PHONE_NUMBER}"
      whatsapp:
        - "${OWNER_WHATSAPP_NUMBER}"
    lockout:
      # When true, critical-risk senders are blocked before authenticated
      # remote commands can mutate runtime state. Production requires true.
      enforcement_enabled: false
      risk_window_ms: 3600000                    # 1h risk calculation window
      state_stale_after_ms: 3600000              # mark cached sender risk stale after 1h
      incident_sender_limit: 50                  # max recent senders rebuilt into health at startup
      elevated_incident_threshold: 1
      critical_incident_threshold: 3
      elevated_rejection_threshold: 5
      critical_rejection_threshold: 15

actions:
  # For Nigeria: use sms as primary (Africa's Talking — no approval required)
  # For UK/EU:   use whatsapp as primary
  primary_alert_channel: sms
  approval_require_scoped_replies: true # Tier C replies must be YES-<proposal_id> / NO-<proposal_id>
  operator_contact: "${OWNER_PHONE_NUMBER}"          # Unified: WHO to contact for Tier-C Approvals
  secondary_contact: ""                              # Optional escalation contact
  setup_notifications:
    enabled: true                    # send a notification-only Tier A status after startup
    channels: [primary]              # use [sms, whatsapp] when both transports are provisioned
  alert_outbox:
    retry_interval_minutes: 0.5        # current default: retry queued alerts every 30 seconds
    max_non_tier_d_attempts: 10        # non-critical alerts are abandoned after this many failed retries
    tier_d_critical_warning_threshold: 3  # Tier D alerts keep retrying; log CRITICAL after this many failures
    batch_size: 50                     # max queued alerts retried per outbox cycle

  whatsapp:
    enabled: true
    TWILIO_ACCOUNT_SID: "${TWILIO_ACCOUNT_SID}"
    TWILIO_AUTH_TOKEN: "${TWILIO_AUTH_TOKEN}"
    TWILIO_WHATSAPP_FROM: "${TWILIO_WHATSAPP_FROM}"

  sms:
    enabled: true                    # SMS transport enabled
    transport: hybrid                # ip | gsm | hybrid
    hybrid_order: gsm_first          # ip_first | gsm_first (used only when transport=hybrid)
    AT_API_KEY: "${AT_API_KEY}"
    AT_USERNAME: "${AT_USERNAME}"
    AT_SENDER_ID: "${AT_SENDER_ID}"
    gsm:
      enabled: false                 # set true to enable direct modem SMS transport
      port: "/dev/ttyUSB0"
      baud: 115200
      sim_pin: ""
      timeout_s: 5.0
      command_timeout_s: 3.0
      write_timeout_s: 3.0
    incoming_webhook:
      enabled: false                 # set true when exposing a public webhook endpoint
      host: "127.0.0.1"
      port: 8080
      path: "/webhooks/sms/africastalking"
      # Public ingress: see docs/SMS_WEBHOOK_SECURITY.md before binding non-loopback.
      allowed_source_cidrs: []       # public webhooks should restrict provider/reverse-proxy IP ranges
      token: "${ORI_SMS_WEBHOOK_TOKEN}"  # required unless signature.mode=hmac_required
      signature:
        mode: token_only              # token_only | hmac_required | token_and_hmac
        shared_secret: "${ORI_SMS_WEBHOOK_HMAC_SECRET}" # required when mode != token_only
        previous_shared_secret: ""    # optional verify-only previous HMAC secret during rotation
        signature_header: "x-ori-webhook-signature"
        timestamp_header: "x-ori-webhook-timestamp"
        nonce_header: "x-ori-webhook-nonce"
        max_skew_seconds: 300
        replay_ttl_seconds: 300
        require_nonce: true

  local_console:
    enabled: false                   # Tier C local fallback when SMS/WhatsApp are unavailable
    poll_interval_ms: 1000
    approval_channel_id: "local_console"

  offline_tokens:
    enabled: false                   # Tier C offline cryptographic approval tokens
    public_key_b64: "${ORI_OFFLINE_TOKEN_PUBKEY_B64}"
    max_clock_skew_s: 300

  relay:
    enabled: false                   # CHANGE TO true ONLY WHEN RELAY IS WIRED
                                     # enabled gates Tier B/C; a gpio_pin also
                                     # declares the always-available Tier D path
    # gpio_pin: 26                   # uncomment only when relay IN is wired
    # Input polarity and the coil mapping are commissioned facts: they come
    # from the signed binding at <data_path>/commissioning/binding.json, and
    # `active_high` here is refused at startup.

  # CoAP command transport (optional; constrained-device actuation path)
  # CoAP commands are executed through `coap_command` actions in skills.
  coap:
    enabled: false
    timeout_s: 2.0
    retries: 1
    allowed_hosts: ["192.168.1.70"]  # required when enabled
    commands:
      open_bypass_valve:
        uri: "coap://192.168.1.70/actuators/bypass"
        method: POST
        payload: '{"state":"open"}'


hal:
  circuit_breaker:
    failure_threshold: 5             # consecutive failures before circuit opens
    recovery_timeout_s: 300          # seconds to wait before probing (HALF_OPEN)
    success_threshold: 2             # consecutive successes in HALF_OPEN to close
  external_watchdog:
    enabled: false                   # optional GPIO heartbeat for external watchdog ICs
    gpio_pin: 17                     # BCM pin connected to watchdog DONE/WDI pin
    ping_interval_s: 30              # heartbeat interval in seconds
  status_signaling:
    enabled: false                   # LED/buzzer runtime state signaling
    power_led_pin: 17                # BCM pin: power source indicator
    relay_led_pin: 27                # BCM pin: relay state indicator
    network_led_pin: 22              # BCM pin: network/cellular indicator
    health_led_pin: 23               # BCM pin: runtime health indicator
    buzzer_pin: 24                   # BCM pin: audible alert indicator
    tick_ms: 100                     # pattern update interval in milliseconds


state:
  compaction:
    max_backward_skew_ms: 3600000    # Threshold (in ms) to reject compaction due to clock skew
  encryption:
    mode: disabled                   # disabled | filesystem_required
    encrypted_path_prefixes: []      # e.g. ["/var/lib/ori-encrypted"]; required for production unless marker_file is set
    marker_file: ""                  # optional existing marker file; startup fails if missing

evidence:
  enabled: false                     # sign Tier C/D actions into the local private evidence chain
  db_path: ori_evidence.db           # chain database (separate from ori_state.db)
  key_path: ori_evidence.key         # sealed Ed25519 device key; created at first start (provisioning)
  device_secret_env: ORI_EVIDENCE_DEVICE_SECRET # env var name; MUST be a random install secret, not just the device serial
  # First start provisions the sealed device key and logs this device's own
  # verification anchor (public key hex). Nothing is asked of you here.
  #
  # Signed evidence cannot be backfilled: actions taken while signing is
  # unavailable are recorded as attestation gaps, never fabricated later.
  # Safety never waits for evidence — a Tier C/D action fires whether or not
  # it can be signed, and the gap stays visible until it is repaired.

logging:
  level: INFO                        # DEBUG | INFO | WARNING | ERROR
  file: ori.log
  max_bytes: 10485760               # 10MB
  backup_count: 3
  log_action_decisions: true        # log every action dispatcher decision
  log_approval_workflow: true       # log Tier C approval requests and responses
