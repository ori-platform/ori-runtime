# Copy to .env in the same directory as ori.yaml (or set ORI_AUTOLOAD_DOTENV=true for dev).
# ori.yaml should only reference ${VAR_NAME} here — do not put secrets in YAML.

# --- Operator (Tier C approvals + Tier A alert destinations for all channels) ---
# Format depends on actions.primary_alert_channel:
#   sms       → E.164, e.g. +2348012345678
#   whatsapp  → whatsapp:+2348012345678
#   telegram  → numeric chat id (DM /start your bot first)
OPERATOR_CONTACT=

# Optional escalation if the primary operator does not respond (same format rules as above).
SECONDARY_CONTACT=

# --- WhatsApp (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- SMS (Africa's Talking) ---
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=

# --- Telegram Bot API (alert_telegram; set actions.telegram.enabled / primary in ori.yaml) ---
TELEGRAM_BOT_TOKEN=
# Optional; scripts/send_router_health_telegram.py prefers this, else OPERATOR_CONTACT, for manual sends.
TELEGRAM_CHAT_ID=

# --- Africa's Talking inbound SMS webhook (only if actions.sms.incoming_webhook.enabled is true) ---
ORI_SMS_WEBHOOK_TOKEN=

# --- Cloud LLM (optional Tier 4 / gateway reasoning) ---
ANTHROPIC_API_KEY=

# --- Relay (optional; if you map RELAY_GPIO_PIN in deploy scripts) ---
RELAY_GPIO_PIN=
