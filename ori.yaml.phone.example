# ori.yaml.phone.example
# Phone-as-Gateway deployment profile (Termux on Android)
#
# This profile is the Ori Energy phone wedge: an Android phone runs the runtime
# in Termux and reads a USB serial energy meter through an OTG adapter. The
# phone is an edge runtime and gateway substitute for Tier A intelligence; it is
# not a substitute for certified Edge Node relay wiring. The operator contact
# below is the customer's normal phone number; it is not assumed to be this
# unattended runtime phone.

device:
  id: phone-gateway-ikeja-01
  name: Ikeja Office Phone Gateway
  location: Lagos, Nigeria
  timezone: Africa/Lagos
  country_code: NG
  deployment_type: phone
  site_type: office

sensors:
  # PZEM-004T or equivalent USB/Modbus energy meter connected to the Android
  # phone's USB port through an OTG adapter. The USB meter is the small sensor
  # device in the phone onboarding kit; Termux only runs the Ori runtime.
  - id: phone-main-power
    type: usb_power
    protocol: usb_serial
    # Use /dev/ttyUSB* or /dev/ttyACM* when Android exposes the meter as a
    # readable tty. If an approved Android USB-serial bridge exposes a local TCP
    # stream instead, use a pyserial URL such as socket://127.0.0.1:7000.
    device_path: /dev/ttyUSB0
    auto_detect_device_path: false
    baud_rate: 9600
    poll_interval_ms: 2000

skills:
  - name: energy-anomaly-detector
    version: "0.1.0"
    config:
      country_code: NG
      tariff_per_kwh: 225.0
      currency_code: NGN

reasoning:
  default_tier: local
  local_model: qwen2.5-0.5b-instruct-q4_k_m  # basename or full .gguf filename/path
  model_path: /data/data/com.termux/files/home/models/
  offline_fallback: rule

gateway:
  enabled: false
  broker_url: ""

telemetry_export:
  # Phone deployments can push real sensor readings directly to the Ori Energy
  # product backend. Leave disabled until the device is registered and the API
  # key is provisioned in Termux as ORI_ENERGY_DEVICE_API_KEY.
  enabled: false
  endpoint: "https://api.ori.energy/runtime/telemetry"
  api_key_env: ORI_ENERGY_DEVICE_API_KEY
  flush_interval_s: 30
  batch_size: 50
  timeout_ms: 3000
  max_queue_size: 1000

health_socket:
  # Termux cannot create /run/ori/health.sock. Keep the local read-only health
  # socket inside the Android app sandbox so support diagnostics and smoke tests
  # work on the dedicated runtime phone.
  enabled: true
  path: /data/data/com.termux/files/home/.ori/health.sock
  mode: 0o660

security:
  config_signature:
    # Assisted Termux pilots may leave this false. The private APK / production
    # launcher should set require_signed true or ORI_CONFIG_REQUIRE_SIGNED=true
    # before loading backend-generated configs.
    require_signed: false
    trust_anchor_env: ORI_CONFIG_TRUST_ANCHOR_PUBLIC_KEY_B64
  skills:
    require_signed: false

actions:
  primary_alert_channel: sms
  operator_contact: "+234XXXXXXXXXX"
  secondary_contact: ""
  setup_notifications:
    enabled: true
    # Use [sms, whatsapp] when both transports are provisioned. Disabled
    # transports are skipped instead of silently generating fake delivery.
    channels: [primary]
  whatsapp:
    enabled: false
  sms:
    enabled: false
  relay:
    # Phone deployments must keep relay disabled. Tier B/C physical actuation
    # requires a certified Ori Edge Node installation.
    enabled: false
    gpio_pin: 26

hal:
  circuit_breaker:
    failure_threshold: 5
    recovery_timeout_s: 300
    success_threshold: 2

logging:
  level: INFO
  file: ori.log
